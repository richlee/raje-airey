---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);

// Sort by date, newest first
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout
  title="Blog - Raje Airey"
  description="Articles on wellbeing, therapy, and mental health from Raje Airey."
>
  {posts.length === 0 ? (
    <section class="coming-soon">
      <h1>Coming soon...</h1>
      <p>Watch this space!</p>
    </section>
  ) : (
    <section class="blog-content">
      <h1>Blog</h1>
      <ul class="post-list">
        {posts.map(post => (
          <li class="post-item">
            <article>
              <h2>
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h2>
              <time class="post-date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              {post.data.description && (
                <p class="post-excerpt">{post.data.description}</p>
              )}
            </article>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="blog-banner">
    <img src="/images/banner-artwork.jpg" alt="" />
  </section>
</BaseLayout>

<style>
  .coming-soon {
    text-align: center;
    padding: 80px var(--spacing-page) 100px;
  }

  .coming-soon h1 {
    font-size: 2.8rem;
    color: #888;
    font-weight: 400;
    margin: 0 0 15px;
  }

  .coming-soon p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin: 0;
  }

  .blog-content {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 50px var(--spacing-page);
  }

  .blog-content h1 {
    margin-top: 0;
  }

  .blog-banner {
    width: 100%;
    height: 150px;
    overflow: hidden;
  }

  .blog-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
  }

  .post-item {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .post-item:first-child {
    padding-top: 0;
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-item h2 {
    margin: 0 0 0.5rem;
    font-size: 1.35rem;
  }

  .post-item h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .post-item h2 a:hover {
    color: var(--color-accent);
  }

  .post-date {
    display: block;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .post-excerpt {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
