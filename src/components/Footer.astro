---
const currentYear = new Date().getFullYear();

const footerNav = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'About', href: '/about/' },
  { label: 'FAQ', href: '/faq/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-contact">
      <div class="contact-item">
        <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>07931 310 820</span>
      </div>
      <div class="contact-item">
        <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        <a href="mailto:info@rajeairey.co.uk">info@rajeairey.co.uk</a>
      </div>
    </div>

    <nav class="footer-nav">
      {footerNav.map(item => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="footer-search">
      <input type="text" placeholder="" aria-label="Search" />
      <button type="submit">Search</button>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} Raje Airey &middot; Stroud, Gloucestershire</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #1a3a5c;
    color: white;
    margin-top: auto;
  }

  .footer-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 40px var(--spacing-page);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: white;
    font-size: 0.95rem;
  }

  .contact-item a {
    color: white;
    text-decoration: none;
  }

  .contact-item a:hover {
    text-decoration: underline;
  }

  .contact-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .footer-nav {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-nav a {
    color: white;
    text-decoration: none;
    font-size: 0.95rem;
    transition: opacity 0.2s ease;
  }

  .footer-nav a:hover {
    opacity: 0.8;
  }

  .footer-search {
    display: flex;
  }

  .footer-search input {
    padding: 10px 15px;
    border: none;
    border-radius: 0;
    font-size: 0.9rem;
    width: 180px;
  }

  .footer-search button {
    padding: 10px 20px;
    background: white;
    border: 2px solid white;
    color: #1a3a5c;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .footer-search button:hover {
    background: transparent;
    color: white;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 20px var(--spacing-page);
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }

    .footer-contact {
      align-items: center;
    }

    .footer-nav {
      gap: 15px;
    }

    .footer-search {
      width: 100%;
      max-width: 300px;
    }

    .footer-search input {
      flex: 1;
    }
  }
</style>
